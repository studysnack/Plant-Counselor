# ═══════════════════════════════════════════════
# Plant Counselor — Root .gitignore
# ═══════════════════════════════════════════════

# ── Python / Backend ──────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/

# SQLite database (local dev data)
*.db
*.db-journal

# Backend env
backend/.env

# Chat debug logs (large, ephemeral)
backend/logs/

# Data backup archives (large, may contain user data)
backend/backups/

# ── Node / Frontend ───────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
frontend/.next/
frontend/out/
frontend/build/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Frontend env
frontend/.env*

# ── IDE / OS ──────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Debug & Logs ──────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Secrets ───────────────────────────────────
.env
.env.*
*.pem
*.key

# ── Playwright MCP (browser automation cache) ─
.playwright-mcp/
.playwright-mcp


# ── Misc ──────────────────────────────────────
*.png.tmp
coverage/
.vercel/

.claude
.claude/

CLAUDE.md
